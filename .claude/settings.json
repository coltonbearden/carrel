      "Bash(rm -rf /etc:*)",
      "Bash(rm -rf /home:*)",
      "Bash(rm -rf /usr:*)",
      "Bash(rm -rf /var:*)",
      "Bash(rm -rf ~:*)",
      "Bash(rm -rf $HOME:*)",
      "Bash(rm -rf ..:*)",
      "Bash(rm -rf .)",
      "Bash(rm -rf ./:*)",
      "Bash(rm -rf src:*)",
      "Bash(rm -rf tests:*)",
      "Bash(rm -rf docs:*)",
      "Bash(rm -rf specs:*)",
      "Bash(rm -rf plugins:*)",
      "Bash(rm -rf .git:*)",
      "Bash(git push --force)",
      "Bash(git push --force *)",
      "Bash(git push * --force)",
      "Bash(git push * --force *)",
      "Bash(git push -f)",
      "Bash(git push -f *)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push *:main)",
      "Bash(git push *refs/heads/main*)",
      "Bash(git push * +*)",
      "Bash(git push --mirror*)",
      "Bash(git push * --mirror*)",
      "Bash(git push --delete*)",
      "Bash(git push * --delete *)",
      "Bash(git push * :*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push --receive-pack*)",
      "Bash(git push * --receive-pack*)",
      "Bash(git push --exec*)",
      "Bash(git push * --exec*)",
      "Bash(git -C * push*)",
      "Bash(git -c * push*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git checkout .:*)",
      "Bash(git checkout -- .:*)",
      "Bash(git checkout -f:*)",
      "Bash(git stash drop:*)",
      "Bash(git stash clear:*)",
      "Bash(git filter-branch:*)",
      "Bash(git update-ref -d:*)",
      "Bash(gh run delete:*)",
      "Bash(gh release delete:*)",
      "Bash(gh repo delete:*)",
      "Bash(gh secret:*)",
      "Bash(gh auth token:*)"
    ]
